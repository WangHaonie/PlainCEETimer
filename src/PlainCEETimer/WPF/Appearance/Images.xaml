<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <PathGeometry x:Key="IconMenu"
        Figures="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18" />
    
    <PathGeometry x:Key="IconExpand"
        Figures="M 4,9 L 4,4 L 9,4 M 15,4 L 20,4 L 20,9 M 20,15 L 20,20 L 15,20 M 9,20 L 4,20 L 4,15" />
    
    <PathGeometry x:Key="IconCollapse"
        Figures="M 4,9 L 9,9 L 9,4 M 15,4 L 15,9 L 20,9 M 20,15 L 15,15 L 15,20 M 9,20 L 9,15 L 4,15" />

    <Style x:Key="GlyphPath" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{DynamicResource ForeText}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>
</ResourceDictionary>
