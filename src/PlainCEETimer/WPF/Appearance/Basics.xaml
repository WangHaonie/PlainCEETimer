<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">
    <CornerRadius x:Key="SmallCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="MenuItemCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SelectionRectangleCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="WindowBorderCornerRadius">8</CornerRadius>

    <System:Double x:Key="ButtonWidth">73</System:Double>
    <System:Double x:Key="ButtonHeight">21</System:Double>

    <Style x:Key="RoundCornerBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource WindowBorderCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Width" Value="73" />
        <Setter Property="Height" Value="21" />
    </Style>
</ResourceDictionary>
